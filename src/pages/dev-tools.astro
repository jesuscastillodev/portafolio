---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import LucideIcon from '../components/LucideIcon.astro';

const title = 'Dev Toolkit — JSON, Base64, JWT y URL | Jcastillo.dev';
const description = 'Utilidades para desarrolladores: formatea y valida JSON, codifica/decodifica Base64 y URL, y decodifica tokens JWT (header y payload). Rápido y privado, todo en tu navegador.';
const canonical = 'https://jcastillo.dev/dev-tools';

const tabs = [
  { id: 'json', label: 'JSON', icon: 'FileJson' },
  { id: 'base64', label: 'Base64', icon: 'Binary' },
  { id: 'jwt', label: 'JWT', icon: 'KeyRound' },
  { id: 'url', label: 'URL', icon: 'Link' },
];
---

<Layout title={title} description={description} canonical={canonical}>
  <Header />
  <div class="h-16"></div>

  <main class="flex flex-col w-full dt-scope">
    <!-- ===== HERO ===== -->
    <section class="relative pt-16 pb-10 lg:pt-20 px-6 overflow-hidden">
      <div class="absolute inset-0 dot-pattern opacity-30"></div>
      <div class="relative max-w-5xl mx-auto" data-animate="fadeInUp">
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-cyan-500/5 dark:bg-cyan-500/10 border border-cyan-500/15 dark:border-cyan-500/25 mb-5">
          <LucideIcon name="Wrench" size={14} class="text-cyan-500" />
          <span class="text-xs font-semibold text-cyan-500 tracking-wider uppercase">Developer Toolkit</span>
        </div>
        <h1 class="text-4xl lg:text-6xl font-black tracking-tight leading-[1.05] mb-5 font-mono">
          <span class="text-cyan-500">&gt;</span> Dev <span class="dt-grad">Toolkit</span>
        </h1>
        <p class="text-lg text-gray-500 dark:text-gray-400 max-w-2xl leading-relaxed font-light">
          Formatea y valida JSON, codifica/decodifica Base64 y URL, y decodifica tokens JWT. Rápido y privado: nada sale de tu navegador.
        </p>
      </div>
    </section>

    <!-- ===== TOOLKIT ===== -->
    <section class="px-6 pb-20">
      <div class="max-w-5xl mx-auto" data-animate="fadeInUp">

        <!-- Editor window -->
        <div class="dt-window glass glow-card rounded-3xl overflow-hidden">
          <!-- Top bar -->
          <div class="dt-bar flex items-center gap-3 px-5 py-3 border-b border-gray-200/70 dark:border-white/10">
            <span class="flex items-center gap-1.5">
              <span class="w-3 h-3 rounded-full bg-rose-400/80"></span>
              <span class="w-3 h-3 rounded-full bg-amber-400/80"></span>
              <span class="w-3 h-3 rounded-full bg-emerald-400/80"></span>
            </span>
            <span class="text-xs font-mono text-gray-400 dark:text-gray-500 ml-1" id="dt-filename">json.tool</span>
          </div>

          <!-- Tabs -->
          <div class="px-5 pt-4">
            <div role="tablist" aria-label="Herramientas de desarrollo" class="flex flex-wrap gap-1.5 p-1 rounded-2xl bg-gray-100 dark:bg-white/5">
              {tabs.map((t) => (
                <button
                  role="tab"
                  id={`tab-${t.id}`}
                  data-tab={t.id}
                  aria-controls={`panel-${t.id}`}
                  aria-selected="false"
                  class="dt-tab inline-flex items-center gap-2 text-sm font-semibold px-4 py-2 rounded-xl transition-all cursor-pointer flex-1 justify-center min-w-28"
                >
                  <LucideIcon name={t.icon} size={15} /> {t.label}
                </button>
              ))}
            </div>
          </div>

          <!-- Panels -->
          <div class="p-5 lg:p-7">

            <!-- ===== JSON ===== -->
            <div role="tabpanel" id="panel-json" aria-labelledby="tab-json" class="dt-panel">
              <div class="grid lg:grid-cols-2 gap-5">
                <!-- Input -->
                <div>
                  <label for="json-input" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Entrada</label>
                  <textarea id="json-input" rows="12" spellcheck="false" autocomplete="off"
                    placeholder={'{\n  "nombre": "Jesús",\n  "stack": ["React", "Laravel"],\n  "activo": true\n}'}
                    class="dt-area w-full px-4 py-3 rounded-2xl bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/10 text-sm font-mono leading-relaxed resize-y focus:outline-none transition-all"></textarea>
                  <div class="flex flex-wrap gap-2 mt-3">
                    <button id="json-format" class="dt-btn-primary">
                      <LucideIcon name="Wand2" size={15} /> Formatear
                    </button>
                    <button id="json-minify" class="dt-btn-ghost">
                      <LucideIcon name="Minus" size={15} /> Minificar
                    </button>
                    <button id="json-clear" class="dt-btn-ghost">
                      <LucideIcon name="Trash2" size={15} /> Limpiar
                    </button>
                  </div>
                  <p id="json-error" class="mt-3 text-sm font-mono text-rose-500 hidden"></p>
                  <p id="json-stat" class="mt-3 text-xs font-mono text-gray-400 hidden"></p>
                </div>
                <!-- Output -->
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <label for="json-output" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider">Resultado</label>
                    <button data-copy-target="json-output" class="dt-copy" aria-label="Copiar resultado JSON">
                      <LucideIcon name="Copy" size={14} /> <span class="dt-copy-label">Copiar</span>
                    </button>
                  </div>
                  <textarea id="json-output" rows="12" readonly spellcheck="false"
                    placeholder="El JSON formateado aparecerá aquí…"
                    class="dt-area w-full px-4 py-3 rounded-2xl bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/10 text-sm font-mono leading-relaxed resize-y focus:outline-none transition-all"></textarea>
                </div>
              </div>
            </div>

            <!-- ===== BASE64 ===== -->
            <div role="tabpanel" id="panel-base64" aria-labelledby="tab-base64" class="dt-panel hidden">
              <div class="flex gap-1 p-1 rounded-xl bg-gray-100 dark:bg-white/5 mb-5 max-w-xs" id="b64-mode" role="group" aria-label="Modo Base64">
                <button data-mode="encode" class="dt-seg flex-1 text-sm font-semibold py-2 rounded-lg transition-all cursor-pointer">Codificar</button>
                <button data-mode="decode" class="dt-seg flex-1 text-sm font-semibold py-2 rounded-lg transition-all cursor-pointer">Decodificar</button>
              </div>
              <div class="grid lg:grid-cols-2 gap-5">
                <div>
                  <label for="b64-input" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Entrada</label>
                  <textarea id="b64-input" rows="10" spellcheck="false" autocomplete="off"
                    placeholder="Escribe texto para codificar a Base64…"
                    class="dt-area w-full px-4 py-3 rounded-2xl bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/10 text-sm font-mono leading-relaxed resize-y focus:outline-none transition-all"></textarea>
                  <button id="b64-clear" class="dt-btn-ghost mt-3">
                    <LucideIcon name="Trash2" size={15} /> Limpiar
                  </button>
                  <p id="b64-error" class="mt-3 text-sm font-mono text-rose-500 hidden"></p>
                </div>
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <label for="b64-output" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider">Resultado</label>
                    <button data-copy-target="b64-output" class="dt-copy" aria-label="Copiar resultado Base64">
                      <LucideIcon name="Copy" size={14} /> <span class="dt-copy-label">Copiar</span>
                    </button>
                  </div>
                  <textarea id="b64-output" rows="10" readonly spellcheck="false"
                    placeholder="El resultado aparecerá aquí…"
                    class="dt-area w-full px-4 py-3 rounded-2xl bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/10 text-sm font-mono leading-relaxed resize-y focus:outline-none transition-all"></textarea>
                </div>
              </div>
            </div>

            <!-- ===== JWT ===== -->
            <div role="tabpanel" id="panel-jwt" aria-labelledby="tab-jwt" class="dt-panel hidden">
              <label for="jwt-input" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Token JWT</label>
              <textarea id="jwt-input" rows="4" spellcheck="false" autocomplete="off"
                placeholder="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiIxMjM0NTY3ODkwIn0.firma"
                class="dt-area w-full px-4 py-3 rounded-2xl bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/10 text-sm font-mono leading-relaxed break-all resize-y focus:outline-none transition-all"></textarea>
              <div class="flex flex-wrap items-center gap-2 mt-3">
                <button id="jwt-clear" class="dt-btn-ghost">
                  <LucideIcon name="Trash2" size={15} /> Limpiar
                </button>
                <span class="inline-flex items-center gap-1.5 text-xs text-amber-600 dark:text-amber-400 px-3 py-1.5 rounded-full bg-amber-500/10 ml-auto">
                  <LucideIcon name="ShieldCheck" size={13} /> No verifica la firma — solo decodifica
                </span>
              </div>
              <p id="jwt-error" class="mt-3 text-sm font-mono text-rose-500 hidden"></p>

              <div id="jwt-result" class="hidden mt-5 grid lg:grid-cols-2 gap-5">
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider"><span class="w-2 h-2 rounded-full bg-rose-400"></span> Header</span>
                    <button data-copy-target="jwt-header" class="dt-copy" aria-label="Copiar header"><LucideIcon name="Copy" size={14} /> <span class="dt-copy-label">Copiar</span></button>
                  </div>
                  <pre id="jwt-header" class="dt-pre rounded-2xl bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/10 p-4 text-sm font-mono overflow-auto max-h-72"></pre>
                </div>
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <span class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-wider"><span class="w-2 h-2 rounded-full bg-violet-400"></span> Payload</span>
                    <button data-copy-target="jwt-payload" class="dt-copy" aria-label="Copiar payload"><LucideIcon name="Copy" size={14} /> <span class="dt-copy-label">Copiar</span></button>
                  </div>
                  <pre id="jwt-payload" class="dt-pre rounded-2xl bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/10 p-4 text-sm font-mono overflow-auto max-h-72"></pre>
                  <div id="jwt-claims" class="mt-3 flex flex-col gap-1.5"></div>
                </div>
              </div>
            </div>

            <!-- ===== URL ===== -->
            <div role="tabpanel" id="panel-url" aria-labelledby="tab-url" class="dt-panel hidden">
              <div class="grid lg:grid-cols-2 gap-5">
                <div>
                  <label for="url-input" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider mb-2">Entrada</label>
                  <textarea id="url-input" rows="8" spellcheck="false" autocomplete="off"
                    placeholder="https://jcastillo.dev/buscar?q=hola mundo&lang=es"
                    class="dt-area w-full px-4 py-3 rounded-2xl bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/10 text-sm font-mono leading-relaxed resize-y focus:outline-none transition-all"></textarea>
                  <div class="flex flex-wrap gap-2 mt-3">
                    <button id="url-encode" class="dt-btn-primary">
                      <LucideIcon name="Lock" size={15} /> Codificar
                    </button>
                    <button id="url-decode" class="dt-btn-ghost">
                      <LucideIcon name="Key" size={15} /> Decodificar
                    </button>
                    <button id="url-clear" class="dt-btn-ghost">
                      <LucideIcon name="Trash2" size={15} /> Limpiar
                    </button>
                  </div>
                  <p id="url-error" class="mt-3 text-sm font-mono text-rose-500 hidden"></p>
                </div>
                <div>
                  <div class="flex items-center justify-between mb-2">
                    <label for="url-output" class="block text-xs font-semibold text-gray-400 uppercase tracking-wider">Resultado</label>
                    <button data-copy-target="url-output" class="dt-copy" aria-label="Copiar resultado URL">
                      <LucideIcon name="Copy" size={14} /> <span class="dt-copy-label">Copiar</span>
                    </button>
                  </div>
                  <textarea id="url-output" rows="8" readonly spellcheck="false"
                    placeholder="El resultado aparecerá aquí…"
                    class="dt-area w-full px-4 py-3 rounded-2xl bg-gray-50 dark:bg-black/30 border border-gray-200 dark:border-white/10 text-sm font-mono leading-relaxed resize-y focus:outline-none transition-all"></textarea>
                </div>
              </div>
            </div>

          </div>
        </div>

        <!-- Footnote -->
        <p class="mt-6 text-center text-xs text-gray-400 flex items-center justify-center gap-2">
          <LucideIcon name="Shield" size={14} class="text-cyan-500" />
          100% en tu navegador. Ningún dato se envía a un servidor.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  /* ===== Terminal / code-editor theme — cyan + sky accent ===== */
  .dt-scope {
    --dt-cyan: #06b6d4;
    --dt-sky: #0ea5e9;
  }
  .dt-grad {
    background: linear-gradient(120deg, var(--dt-cyan), var(--dt-sky));
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    color: transparent;
  }
  .dt-window { box-shadow: 0 20px 60px -25px rgba(6, 182, 212, 0.25); }
  .dt-bar { background: rgba(241, 245, 249, 0.6); }
  :global(.dark) .dt-bar { background: rgba(2, 6, 23, 0.4); }

  /* Tabs */
  .dt-tab { color: #64748b; }
  :global(.dark) .dt-tab { color: #94a3b8; }
  .dt-tab:hover { color: var(--dt-cyan); }
  .dt-tab[aria-selected="true"] {
    background: linear-gradient(120deg, var(--dt-cyan), var(--dt-sky));
    color: #fff;
    box-shadow: 0 6px 16px -6px rgba(6, 182, 212, 0.6);
  }

  /* Segmented (Base64 mode) */
  .dt-seg { color: #64748b; }
  :global(.dark) .dt-seg { color: #94a3b8; }
  .dt-seg.active {
    background: linear-gradient(120deg, var(--dt-cyan), var(--dt-sky));
    color: #fff;
    box-shadow: 0 4px 12px -4px rgba(6, 182, 212, 0.5);
  }

  /* Text areas — focus ring in cyan */
  .dt-area:focus { border-color: var(--dt-cyan); box-shadow: 0 0 0 3px rgba(6, 182, 212, 0.18); }
  .dt-pre { white-space: pre-wrap; word-break: break-word; }

  /* Buttons */
  .dt-btn-primary {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    background: linear-gradient(120deg, var(--dt-cyan), var(--dt-sky));
    color: #fff; font-size: 0.875rem; font-weight: 600;
    border-radius: 0.75rem; padding: 0.625rem 1.1rem; cursor: pointer;
    transition: transform .25s ease, box-shadow .25s ease;
  }
  .dt-btn-primary:hover { transform: translateY(-2px); box-shadow: 0 10px 24px -8px rgba(6, 182, 212, 0.6); }
  .dt-btn-ghost {
    display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
    background: rgba(148, 163, 184, 0.12);
    color: #475569; font-size: 0.875rem; font-weight: 600;
    border-radius: 0.75rem; padding: 0.625rem 1.1rem; cursor: pointer;
    transition: background .2s ease, transform .2s ease;
  }
  :global(.dark) .dt-btn-ghost { color: #cbd5e1; background: rgba(255, 255, 255, 0.06); }
  .dt-btn-ghost:hover { background: rgba(6, 182, 212, 0.12); transform: translateY(-1px); }

  /* Copy button */
  .dt-copy {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 0.75rem; font-weight: 600; color: #64748b;
    padding: 0.25rem 0.6rem; border-radius: 0.5rem; cursor: pointer;
    transition: color .2s ease, background .2s ease;
  }
  :global(.dark) .dt-copy { color: #94a3b8; }
  .dt-copy:hover { color: var(--dt-cyan); background: rgba(6, 182, 212, 0.1); }
  .dt-copy.copied { color: #10b981; }
</style>

<script>
  const $ = <T extends HTMLElement = HTMLElement>(s: string) => document.querySelector(s) as T;
  const $$ = (s: string) => Array.from(document.querySelectorAll(s));

  // ===== Tabs =====
  const filenames: Record<string, string> = {
    json: 'json.tool', base64: 'base64.tool', jwt: 'jwt.tool', url: 'url.tool',
  };
  const tabBtns = $$('[data-tab]') as HTMLButtonElement[];
  function activateTab(id: string) {
    tabBtns.forEach((b) => {
      const on = b.dataset.tab === id;
      b.setAttribute('aria-selected', on ? 'true' : 'false');
    });
    $$('.dt-panel').forEach((p) => p.classList.toggle('hidden', p.id !== `panel-${id}`));
    const fn = $('#dt-filename');
    if (fn) fn.textContent = filenames[id] ?? id;
  }
  tabBtns.forEach((b) => b.addEventListener('click', () => activateTab(b.dataset.tab!)));
  activateTab('json');

  // ===== Copy helper =====
  $$('[data-copy-target]').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const target = document.getElementById((btn as HTMLElement).dataset.copyTarget!);
      if (!target) return;
      const text = (target as HTMLTextAreaElement).value ?? target.textContent ?? '';
      if (!text.trim()) return;
      try {
        await navigator.clipboard.writeText(text);
        const label = btn.querySelector('.dt-copy-label');
        btn.classList.add('copied');
        const prev = label?.textContent;
        if (label) label.textContent = 'Copiado';
        setTimeout(() => { btn.classList.remove('copied'); if (label) label.textContent = prev ?? 'Copiar'; }, 1400);
      } catch {}
    });
  });

  // ===== JSON =====
  const jsonInput = $('#json-input') as HTMLTextAreaElement;
  const jsonOutput = $('#json-output') as HTMLTextAreaElement;
  const jsonError = $('#json-error');
  const jsonStat = $('#json-stat');

  function showJsonError(msg: string) {
    jsonError.textContent = '⨯ ' + msg;
    jsonError.classList.remove('hidden');
    jsonStat.classList.add('hidden');
  }
  function clearJsonError() { jsonError.classList.add('hidden'); }

  function countKeys(obj: unknown): number {
    let n = 0;
    const walk = (v: unknown) => {
      if (Array.isArray(v)) v.forEach(walk);
      else if (v && typeof v === 'object') {
        for (const k of Object.keys(v as object)) { n++; walk((v as Record<string, unknown>)[k]); }
      }
    };
    walk(obj);
    return n;
  }

  function processJson(pretty: boolean) {
    const raw = jsonInput.value.trim();
    if (!raw) { jsonOutput.value = ''; clearJsonError(); jsonStat.classList.add('hidden'); return; }
    try {
      const obj = JSON.parse(raw);
      const out = pretty ? JSON.stringify(obj, null, 2) : JSON.stringify(obj);
      jsonOutput.value = out;
      clearJsonError();
      jsonStat.textContent = `${countKeys(obj)} claves · ${out.length} caracteres`;
      jsonStat.classList.remove('hidden');
    } catch (e) {
      jsonOutput.value = '';
      showJsonError((e as Error).message);
    }
  }
  $('#json-format').addEventListener('click', () => processJson(true));
  $('#json-minify').addEventListener('click', () => processJson(false));
  $('#json-clear').addEventListener('click', () => {
    jsonInput.value = ''; jsonOutput.value = ''; clearJsonError(); jsonStat.classList.add('hidden'); jsonInput.focus();
  });

  // ===== Base64 =====
  const b64Input = $('#b64-input') as HTMLTextAreaElement;
  const b64Output = $('#b64-output') as HTMLTextAreaElement;
  const b64Error = $('#b64-error');
  let b64Mode: 'encode' | 'decode' = 'encode';

  function runBase64() {
    const raw = b64Input.value;
    b64Error.classList.add('hidden');
    if (!raw) { b64Output.value = ''; return; }
    try {
      if (b64Mode === 'encode') {
        b64Output.value = btoa(unescape(encodeURIComponent(raw)));
      } else {
        b64Output.value = decodeURIComponent(escape(atob(raw.trim())));
      }
    } catch {
      b64Output.value = '';
      b64Error.textContent = b64Mode === 'decode'
        ? '⨯ Base64 inválido: no se pudo decodificar.'
        : '⨯ No se pudo codificar el texto.';
      b64Error.classList.remove('hidden');
    }
  }
  function setB64Mode(m: 'encode' | 'decode') {
    b64Mode = m;
    $$('#b64-mode .dt-seg').forEach((b) => b.classList.toggle('active', (b as HTMLElement).dataset.mode === m));
    b64Input.placeholder = m === 'encode'
      ? 'Escribe texto para codificar a Base64…'
      : 'Pega Base64 para decodificar a texto…';
    runBase64();
  }
  $$('#b64-mode .dt-seg').forEach((b) => b.addEventListener('click', () => setB64Mode((b as HTMLElement).dataset.mode as 'encode' | 'decode')));
  b64Input.addEventListener('input', runBase64);
  $('#b64-clear').addEventListener('click', () => { b64Input.value = ''; b64Output.value = ''; b64Error.classList.add('hidden'); b64Input.focus(); });
  setB64Mode('encode');

  // ===== JWT =====
  const jwtInput = $('#jwt-input') as HTMLTextAreaElement;
  const jwtResult = $('#jwt-result');
  const jwtError = $('#jwt-error');
  const jwtHeader = $('#jwt-header');
  const jwtPayload = $('#jwt-payload');
  const jwtClaims = $('#jwt-claims');

  function b64urlDecode(str: string): string {
    let s = str.replace(/-/g, '+').replace(/_/g, '/');
    const pad = s.length % 4;
    if (pad === 2) s += '==';
    else if (pad === 3) s += '=';
    else if (pad === 1) throw new Error('longitud base64url inválida');
    return decodeURIComponent(escape(atob(s)));
  }
  function fmtDate(ts: number): string {
    try {
      return new Date(ts * 1000).toLocaleString('es-CL', {
        day: '2-digit', month: '2-digit', year: 'numeric',
        hour: '2-digit', minute: '2-digit', second: '2-digit',
      });
    } catch { return String(ts); }
  }
  function claimRow(label: string, ts: number): string {
    const expired = label === 'Expira (exp)' && ts * 1000 < Date.now();
    return `<div class="flex items-center justify-between gap-3 text-xs font-mono px-3 py-2 rounded-lg bg-gray-50 dark:bg-white/5">
      <span class="text-gray-400">${label}</span>
      <span class="${expired ? 'text-rose-500 font-bold' : 'text-gray-600 dark:text-gray-300'}">${fmtDate(ts)}${expired ? ' · expirado' : ''}</span>
    </div>`;
  }

  function decodeJwt() {
    const raw = jwtInput.value.trim();
    jwtError.classList.add('hidden');
    jwtClaims.innerHTML = '';
    if (!raw) { jwtResult.classList.add('hidden'); return; }
    const parts = raw.split('.');
    if (parts.length < 2) {
      jwtResult.classList.add('hidden');
      jwtError.textContent = '⨯ Token malformado: se esperan al menos header.payload separados por punto.';
      jwtError.classList.remove('hidden');
      return;
    }
    try {
      const header = JSON.parse(b64urlDecode(parts[0]));
      const payload = JSON.parse(b64urlDecode(parts[1]));
      jwtHeader.textContent = JSON.stringify(header, null, 2);
      jwtPayload.textContent = JSON.stringify(payload, null, 2);
      jwtResult.classList.remove('hidden');

      const claims: string[] = [];
      if (typeof payload.iat === 'number') claims.push(claimRow('Emitido (iat)', payload.iat));
      if (typeof payload.nbf === 'number') claims.push(claimRow('Válido desde (nbf)', payload.nbf));
      if (typeof payload.exp === 'number') claims.push(claimRow('Expira (exp)', payload.exp));
      jwtClaims.innerHTML = claims.join('');
    } catch (e) {
      jwtResult.classList.add('hidden');
      jwtError.textContent = '⨯ No se pudo decodificar el token: ' + (e as Error).message;
      jwtError.classList.remove('hidden');
    }
  }
  jwtInput.addEventListener('input', decodeJwt);
  $('#jwt-clear').addEventListener('click', () => { jwtInput.value = ''; jwtResult.classList.add('hidden'); jwtError.classList.add('hidden'); jwtClaims.innerHTML = ''; jwtInput.focus(); });

  // ===== URL =====
  const urlInput = $('#url-input') as HTMLTextAreaElement;
  const urlOutput = $('#url-output') as HTMLTextAreaElement;
  const urlError = $('#url-error');

  function runUrl(mode: 'encode' | 'decode') {
    const raw = urlInput.value;
    urlError.classList.add('hidden');
    if (!raw) { urlOutput.value = ''; return; }
    try {
      urlOutput.value = mode === 'encode' ? encodeURIComponent(raw) : decodeURIComponent(raw);
    } catch {
      urlOutput.value = '';
      urlError.textContent = '⨯ No se pudo decodificar: secuencia % inválida.';
      urlError.classList.remove('hidden');
    }
  }
  $('#url-encode').addEventListener('click', () => runUrl('encode'));
  $('#url-decode').addEventListener('click', () => runUrl('decode'));
  $('#url-clear').addEventListener('click', () => { urlInput.value = ''; urlOutput.value = ''; urlError.classList.add('hidden'); urlInput.focus(); });
</script>
